<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:KotKas.Helpers">

    <!-- Converters -->
    <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />

    <!-- Kaartje (uitgave, kotgenoot, formulier) -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource KkCard}" />
        <Setter Property="Stroke" Value="{StaticResource KkBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Bolletje met initialen -->
    <Style x:Key="AvatarBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource KkAccentLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="AvatarLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource KkPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Teksten -->
    <Style x:Key="HeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="SubHeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#D9F2E9" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KkText}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KkMuted}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KkText}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource KkMuted}" />
    </Style>

    <Style x:Key="AmountLabel" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KkText}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource KkNegative}" />
        <Setter Property="BackgroundColor" Value="{StaticResource KkNegativeLight}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource KkPrimaryDark}" />
        <Setter Property="BackgroundColor" Value="{StaticResource KkAccentLight}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="FieldSeparator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource KkBorder}" />
    </Style>

    <!-- Knoppen -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource KkAccentLight}" />
        <Setter Property="TextColor" Value="{StaticResource KkPrimary}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource KkNegativeLight}" />
        <Setter Property="TextColor" Value="{StaticResource KkNegative}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource KkPrimary}" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

</ResourceDictionary>
