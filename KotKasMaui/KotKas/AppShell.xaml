<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KotKas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KotKas.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource KkPrimary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="{StaticResource KkPrimary}"
    Shell.TabBarTitleColor="{StaticResource KkPrimary}"
    Shell.TabBarUnselectedColor="#8FA39B"
    Title="KotKas">

    <TabBar>
        <ShellContent
            Title="Scannen"
            Icon="tab_scan.png"
            Route="scan"
            ContentTemplate="{DataTemplate views:ScanPage}" />

        <ShellContent
            Title="Uitgaven"
            Icon="tab_expenses.png"
            Route="expenses"
            ContentTemplate="{DataTemplate views:ExpensesPage}" />

        <ShellContent
            Title="Kotgenoten"
            Icon="tab_roommates.png"
            Route="roommates"
            ContentTemplate="{DataTemplate views:RoommatesPage}" />
    </TabBar>

</Shell>
